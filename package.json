{
  "name": "agentlens",
  "version": "0.0.1",
  "description": "Record, replay and diff agent executions. Local-first agent execution debugger CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentlens": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "lint": "biome check . && tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx examples/demo-agent.ts"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/node": "^22.18.6",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
